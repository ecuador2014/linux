# HEXAOS - perfil car, x86_64, libc glibc, ROS 2: yes  (GENERADO por tools/gen-defconfigs.sh)
BR2_x86_64=y
BR2_LINUX_KERNEL_BZIMAGE=y
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_OPTIMIZE_2=y
BR2_TARGET_GENERIC_HOSTNAME="hexa-car"
BR2_TARGET_GENERIC_ISSUE="HEXAOS - car"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/overlay-common $(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/overlay-car $(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/overlay-ros2"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/post-build.sh"
BR2_SYSTEM_DHCP="eth0"
# Cabeceras de la toolchain: serie 6.12 (Buildroot 2025.02 no conoce 6.18); el kernel sigue siendo 6.18.55
BR2_KERNEL_HEADERS_6_12=y
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.55"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/linux-base.fragment $(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/linux-car.fragment"
BR2_PACKAGE_BUSYBOX_WATCHDOG=y
BR2_PACKAGE_BUSYBOX_WATCHDOG_PERIOD=5
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_CHRONY=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_CAN_UTILS=y
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_SPI_TOOLS=y
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_RT_TESTS=y
BR2_PACKAGE_V4L_UTILS=y
BR2_PACKAGE_PYTHON3=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="2G"
BR2_PACKAGE_LINUXPTP=y
BR2_PACKAGE_GPSD=y
BR2_PACKAGE_TCPDUMP=y
BR2_PACKAGE_LIBPCAP=y
# Capa ROS 2 (necesita glibc)
BR2_PACKAGE_BASH=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBYAML=y
BR2_PACKAGE_TINYXML2=y
BR2_PACKAGE_SPDLOG=y
BR2_PACKAGE_EIGEN=y
BR2_PACKAGE_ACL=y
BR2_PACKAGE_PYTHON_NUMPY=y
BR2_PACKAGE_PYTHON_YAML=y
BR2_PACKAGE_PYTHON_SETUPTOOLS=y
BR2_PACKAGE_PYTHON_LXML=y
BR2_PACKAGE_ROS2_RUNTIME=y
BR2_PACKAGE_ROS2_RUNTIME_TARBALL="$(BR2_EXTERNAL_HEXAOS_PATH)/ros2/output/car_x86_64/ros2-install.tar.gz"
