# HEXAOS - perfil mini, arm, libc musl, ROS 2: no  (GENERADO por tools/gen-defconfigs.sh)
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_LINUX_KERNEL_ZIMAGE=y
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="multi_v7"
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_OPTIMIZE_2=y
BR2_TARGET_GENERIC_HOSTNAME="hexa-mini"
BR2_TARGET_GENERIC_ISSUE="HEXAOS - mini"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/overlay-common $(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/overlay-mini"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/post-build.sh"
BR2_SYSTEM_DHCP="eth0"
# Cabeceras de la toolchain: serie 6.12 (Buildroot 2025.02 no conoce 6.18); el kernel sigue siendo 6.18.55
BR2_KERNEL_HEADERS_6_12=y
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.55"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/linux-base.fragment $(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/linux-mini.fragment"
BR2_PACKAGE_BUSYBOX_WATCHDOG=y
BR2_PACKAGE_BUSYBOX_WATCHDOG_PERIOD=5
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_CHRONY=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_CAN_UTILS=y
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_SPI_TOOLS=y
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_RT_TESTS=y
BR2_PACKAGE_V4L_UTILS=y
BR2_PACKAGE_PYTHON3=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="128M"
BR2_PACKAGE_PYTHON_SERIAL=y
BR2_PACKAGE_MOSQUITTO=y
BR2_PACKAGE_MOSQUITTO_BROKER=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_SOCAT=y
