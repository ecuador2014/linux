# HEXAOS - perfil car, aarch64, libc musl, capa: gui  (GENERADO por tools/gen-defconfigs.sh)
BR2_aarch64=y
BR2_cortex_a72=y
BR2_LINUX_KERNEL_IMAGE=y
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_OPTIMIZE_2=y
BR2_TARGET_GENERIC_HOSTNAME="hexa-car"
BR2_TARGET_GENERIC_ISSUE="HEXAOS - car"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/overlay-common $(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/overlay-car $(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/overlay-gui"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/post-build.sh"
BR2_SYSTEM_DHCP="eth0"
# Cabeceras de la toolchain: serie 6.12 (Buildroot 2025.02 no conoce 6.18); el kernel sigue siendo 6.18.55
BR2_KERNEL_HEADERS_6_12=y
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.55"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/linux-base.fragment $(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/linux-car.fragment $(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/linux-gui.fragment"
BR2_PACKAGE_BUSYBOX_WATCHDOG=y
BR2_PACKAGE_BUSYBOX_WATCHDOG_PERIOD=5
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_CHRONY=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_CAN_UTILS=y
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_SPI_TOOLS=y
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_RT_TESTS=y
BR2_PACKAGE_V4L_UTILS=y
BR2_PACKAGE_PYTHON3=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="768M"
BR2_PACKAGE_LINUXPTP=y
BR2_PACKAGE_GPSD=y
BR2_PACKAGE_TCPDUMP=y
BR2_PACKAGE_LIBPCAP=y
# Capa grafica: kiosco Wayland con Cage (una sola aplicacion a pantalla completa)
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_CAGE=y
BR2_PACKAGE_FOOT=y
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_SEATD_DAEMON=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_XKEYBOARD_CONFIG=y
BR2_PACKAGE_DEJAVU=y
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/gui-users.table"
