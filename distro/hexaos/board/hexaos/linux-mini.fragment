# Mini: PWM/I2C/SPI/1-Wire, UART, WiFi, Bluetooth, MCP2515 opcional
CONFIG_PWM=y
CONFIG_W1=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_CAN=y
CONFIG_CAN_RAW=y
CONFIG_CAN_DEV=y
CONFIG_CAN_VCAN=y
CONFIG_CAN_MCP251X=y
CONFIG_SND=y
CONFIG_SND_USB_AUDIO=y
# Recorte extra de peso
# CONFIG_IPV6 is not set
# CONFIG_EXT2_FS_XATTR is not set
