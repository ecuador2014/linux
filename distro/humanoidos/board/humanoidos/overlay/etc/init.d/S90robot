#!/bin/sh
# Supervisor del proceso de control. Si cae, envia e-stop por CAN y reintenta.
. /etc/robot/robot.conf
PIDFILE=/var/run/robot-supervisor.pid

estop() { [ -n "$ESTOP_FRAME" ] && cansend "$ESTOP_IFACE" "$ESTOP_FRAME" 2>/dev/null; }

supervise() {
    while :; do
        if [ -x "$ROBOT_CORE" ]; then
            taskset -c "$RT_CPUS" chrt -f "$RT_PRIO" "$ROBOT_CORE"
            logger -t robot "robot-core termino (rc=$?): e-stop"
            estop
        fi
        sleep 2
    done
}

case "$1" in
  start)
    supervise &
    echo $! > "$PIDFILE"
    ;;
  stop)
    [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
    pkill -x "$(basename "$ROBOT_CORE")" 2>/dev/null
    estop
    rm -f "$PIDFILE"
    ;;
  *) echo "Uso: $0 {start|stop}"; exit 1 ;;
esac
