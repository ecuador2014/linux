# HumanoidOS - x86_64 (mini-PC / NUC / QEMU). Toolchain musl, init BusyBox.
BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_OPTIMIZE_2=y
BR2_TARGET_GENERIC_HOSTNAME="humanoid"
BR2_TARGET_GENERIC_ISSUE="HumanoidOS - control en tiempo real"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_HUMANOIDOS_PATH)/board/humanoidos/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_HUMANOIDOS_PATH)/board/humanoidos/post-build.sh"
BR2_SYSTEM_DHCP="eth0"
# Kernel (PREEMPT_RT mainline desde 6.12)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.20"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_HUMANOIDOS_PATH)/board/humanoidos/linux-robot.fragment"
BR2_LINUX_KERNEL_BZIMAGE=y
# Sistema
BR2_PACKAGE_BUSYBOX_WATCHDOG=y
BR2_PACKAGE_BUSYBOX_WATCHDOG_PERIOD=5
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_CHRONY=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_HTOP=y
# Buses de robot: CAN, GPIO, I2C, SPI, input
BR2_PACKAGE_CAN_UTILS=y
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_SPI_TOOLS=y
BR2_PACKAGE_EVTEST=y
# Diagnostico de latencia RT
BR2_PACKAGE_RT_TESTS=y
# Percepcion / voz
BR2_PACKAGE_V4L_UTILS=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_ARECORD=y
BR2_PACKAGE_ALSA_UTILS_ALSAMIXER=y
# Scripting de alto nivel
BR2_PACKAGE_PYTHON3=y
# Imagen
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
