config BR2_PACKAGE_ROS2_RUNTIME
	bool "ros2-runtime"
	depends on BR2_TOOLCHAIN_USES_GLIBC
	depends on BR2_PACKAGE_PYTHON3
	help
	  Instala en /opt/ros un arbol ROS 2 precompilado
	  (ver ros2/cross-build.sh).

if BR2_PACKAGE_ROS2_RUNTIME

config BR2_PACKAGE_ROS2_RUNTIME_TARBALL
	string "Ruta al tarball del install tree de ROS 2"
	default "$(BR2_EXTERNAL_HUMANOIDOS_PATH)/ros2/output/ros2-install.tar.gz"

endif

comment "ros2-runtime necesita toolchain glibc y python3"
	depends on !BR2_TOOLCHAIN_USES_GLIBC || !BR2_PACKAGE_PYTHON3
